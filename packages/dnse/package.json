{
	"name": "@vnstock/dnse",
	"version": "0.1.0",
	"description": "TypeScript SDK and OpenAPI Client for DNSE Securities Trading & Market Data API",
	"private": true,
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./api": {
			"types": "./dist/api/index.d.ts",
			"import": "./dist/api/index.js",
			"require": "./dist/api/index.cjs"
		},
		"./websocket": {
			"types": "./dist/websocket/index.d.ts",
			"import": "./dist/websocket/index.js",
			"require": "./dist/websocket/index.cjs"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsup && tsc --declaration --emitDeclarationOnly --outDir dist",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"generate-client": "openapi-ts",
		"clean": "rm -rf dist"
	},
	"keywords": [
		"vnstock",
		"dnse",
		"trading",
		"stock",
		"vietnam",
		"websocket",
		"openapi",
		"sdk"
	],
	"dependencies": {
		"@msgpack/msgpack": "^3.1.3",
		"axios": "^1.21.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@hey-api/client-axios": "^0.9.1",
		"@hey-api/openapi-ts": "0.97.3",
		"@types/node": "^26.6.5",
		"tsup": "^9.0.0",
		"typescript": "^7.0.2"
	}
}
