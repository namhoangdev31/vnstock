{
  "name": "fastapi-full-stack-template",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "mobile": "pnpm --filter vnstock start",
    "lint": "pnpm --filter frontend lint",
    "test": "pnpm --filter frontend test",
    "test:ui": "pnpm --filter frontend test:ui",
    "dnse:build": "pnpm --filter @vnstock/dnse build",
    "dnse:generate": "pnpm --filter @vnstock/dnse generate-client",
    "email:dev": "pnpm --filter emails dev",
    "email:export": "pnpm --filter emails export",
    "stripcomment": "pnpm dlx tsx scripts/strip-comments.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12"
  }
}